generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  products      Product[]
  sellers       Seller[]
  purchases     Purchase[]
  sales         Sale[]
  budgets       Budget[]
}

model Budget {
  id          String   @id @default(uuid())
  category    String
  limit       Float
  period      String   @default("monthly") // "weekly", "monthly", "yearly"
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category])
}

model Product {
  id           String   @id @default(uuid())
  name         String
  description  String?
  category     String   @default("Other")
  sku          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sellerProducts SellerProduct[]
  purchases     Purchase[]
  sales         Sale[]
  
  @@unique([userId, name])
}

model Seller {
  id           String   @id @default(uuid())
  name         String
  contactInfo  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sellerProducts SellerProduct[]
  purchases     Purchase[]
  sales         Sale[]
  
  @@unique([userId, name])
}

model SellerProduct {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  costPrice    Float
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sellerId, productId])
}

model Purchase {
  id           String   @id @default(uuid())
  quantity     Int
  unitPrice    Float
  totalCost    Float    // Investment: quantity * unitPrice
  date         DateTime
  createdAt    DateTime @default(now())
  
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sale {
  id           String   @id @default(uuid())
  quantity     Int
  unitPrice    Float
  totalRevenue Float    // Revenue: quantity * unitPrice
  comment      String?  // Optional comment for general sales, required if stock <= 0
  date         DateTime
  createdAt    DateTime @default(now())
  
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId     String?
  seller       Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
